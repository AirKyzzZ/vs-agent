{
  "name": "@verana-labs/vs-agent-plugin-openid4vc",
  "main": "build/index",
  "types": "build/index",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "require": "./build/index.js",
      "default": "./build/index.js"
    }
  },
  "version": "1.11.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/verana-labs/vs-agent"
  },
  "files": ["build"],
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0",
  "description": "OpenID4VC (OID4VCI issuer, OID4VP verifier, holder) plugin for VS Agent with Verana trust resolution",
  "scripts": {
    "build": "pnpm run clean && pnpm run compile",
    "clean": "rimraf -rf ./build",
    "compile": "tsc -p tsconfig.build.json",
    "prepublishOnly": "pnpm run build",
    "version": "pnpm version --allow-same-version",
    "test": "vitest"
  },
  "dependencies": {
    "@credo-ts/openid4vc": "0.7.1-pr-2704-20260519192541",
    "@nestjs/common": "^10.0.0",
    "@verana-labs/vs-agent-model": "workspace:*",
    "@verana-labs/vs-agent-sdk": "workspace:*",
    "express": "^5.2.1"
  },
  "peerDependencies": {
    "@credo-ts/core": "0.7.1-pr-2704-20260519192541"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
